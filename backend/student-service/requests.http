###
PATCH {{baseUrl}}/students/{{created.response.body.id}}
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "fullName": "Laila M. Mostafa",
  "courseIds": [1]
}

###
DELETE {{baseUrl}}/students/{{created.response.body.id}}
Authorization: Bearer {{login.response.body.token}}

###
POST {{baseUrl}}/attendance/absences
X-Internal-Key: {{internalKey}}
Content-Type: application/json

{
  "sessionId": 1,
  "courseId": 1
}

###
PATCH {{baseUrl}}/excuses/1/status
X-Internal-Key: {{internalKey}}
Content-Type: application/json

{
  "decision": "approved"
}

###
GET {{baseUrl}}/courses/1/attendance-totals
X-Internal-Key: {{internalKey}}

###
GET {{baseUrl}}/courses/1/attendance-totals

